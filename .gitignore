# Local toolchain, export artifacts, logs, and isolated smoke-test data.
/build/
# Local Python tooling bytecode.
__pycache__/
*.pyc
# Never commit Android signing keys or machine-specific SDK configuration.
*.keystore
*.jks
local.properties

# Private Apple/Windows signing material and local environment credentials.
*.p12
*.pfx
*.mobileprovision
*.provisionprofile
AuthKey_*.p8
.env
.env.*
!.env.example
