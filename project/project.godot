; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ERA-LIFE Experiment 2.0"
config/version="0.1.3"
run/main_scene="res://scenes/main.scn"
run/main_scene.android="res://scenes/mobile_boot.tscn"
config/features=PackedStringArray("4.4", "Mobile")
config/icon="res://branding/EraLifeIcon.png"
config/macos_native_icon="res://branding/EraLifeIcon.png"
config/windows_native_icon="res://branding/EraLifeIcon.png"
run/flush_stdout_on_print.android=true

[autoload]

SelfHostRuntime="*res://SelfHostRuntimeLayer.gd"
ReleaseUpdateRuntimeLayer="*res://ReleaseUpdateRuntimeLayer.gd"

[community]

updates/allow_upstream_runtime=false
updates/allow_upstream_runtime.android=true

[debug]

file_logging/enable_file_logging.android=true
file_logging/max_log_files.android=2

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/size/viewport_width.android=960
window/size/viewport_height.android=540

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
